{
  "diagram": { "maxNodes": 25, "splitBy": "directory" },
  "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.git/**", "**/.greplost/**", "**/*.d.ts", "**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/testdata/**", "**/*_test.go", "**/vendor/**", "fixtures/**", "bench/fixtures/**", "bench/.corpus/**", "bench/.competitors/**"],
  "include": ["**"],
  "languages": ["ts", "tsx", "js", "jsx", "dockerfile", "go", "java", "kotlin", "python", "rust", "yaml"],
  "packages": { "roots": ["packages/*", "bench"] },
  "semantic": { "enabled": true, "model": "claude-sonnet-5" }
}
