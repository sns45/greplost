{
  "diagram": {
    "maxNodes": 25,
    "splitBy": "directory"
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**",
    "**/.greplost/**",
    "**/*.d.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "**/testdata/**",
    "**/*_test.go",
    "**/test_*.py",
    "**/*_test.py",
    "**/conftest.py",
    "**/vendor/**"
  ],
  "include": [
    "**"
  ],
  "languages": [
    "js",
    "ts",
    "yaml"
  ],
  "packages": {
    "roots": []
  },
  "semantic": {
    "enabled": true,
    "model": "claude-sonnet-5"
  }
}
